FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --filter @aqua0/mcp...
COPY apps/mcp apps/mcp
COPY packages/shared packages/shared
RUN pnpm --filter @aqua0/shared build && pnpm --filter @aqua0/mcp build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/mcp ./apps/mcp
COPY --from=build /app/packages/shared ./packages/shared
ENV MCP_TRANSPORT=http HOST=0.0.0.0 PORT=3000
CMD ["node", "apps/mcp/dist/index.js"]
