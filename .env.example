# Required Graph endpoint for the Aqua0 subgraph.
GRAPH_ENDPOINT=
GRAPH_NETWORK=arc-testnet

# Optional Graph bearer token. Treated as a secret and never shown by info.
GRAPH_AUTH_TOKEN=

# Shape-C write preparation/execution configuration.
WRITE_RPC_URL=https://rpc.testnet.arc.network
WRITE_CHAIN_ID=5042002
VAULT_REGISTRY_ADDRESS=
MCP_WRITE_MODE=prepare

# Required only when MCP_WRITE_MODE=execute and the chain guard allows execution.
WRITE_PRIVATE_KEY=

# MCP transport configuration.
MCP_TRANSPORT=stdio

# HTTP MCP bind configuration (used when MCP_TRANSPORT=http).
HOST=0.0.0.0
PORT=3000
