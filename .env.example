# Required Graph endpoint for the Aqua0 subgraph.
GRAPH_ENDPOINT=
GRAPH_NETWORK=arc-testnet

# Optional Graph bearer token. Treated as a secret and never shown by info.
GRAPH_AUTH_TOKEN=

# Aqua0 vault write preparation/execution configuration.
WRITE_RPC_URL=https://rpc.testnet.arc.network
WRITE_CHAIN_ID=5042002
VAULT_REGISTRY_ADDRESS=
MCP_WRITE_MODE=prepare

# Required only when MCP_WRITE_MODE=execute and the chain guard allows execution.
WRITE_PRIVATE_KEY=

# Execute-mode signer: local (default, WRITE_PRIVATE_KEY) or circle (Circle developer-controlled wallet on Arc Testnet).
SIGNER=local
# Secrets for SIGNER=circle (ENTITY_SECRET is also accepted). Never shown by info.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Either a fixed wallet, or a wallet set plus a user ref: the wallet whose refId is the user ref, created on first use.
CIRCLE_WALLET_ID=
CIRCLE_WALLET_SET_ID=
CIRCLE_USER_REF=
# Shared operator wallet (a Circle EOA holding OPERATOR_ROLE on the AquaAdapters). It sends the strategy ships users
# sign and tops up a newly signed-in wallet holding under 1 USDC with AQUA0_ONBOARD_USDC testnet USDC (0 disables).
CIRCLE_OPERATOR_WALLET_ID=
AQUA0_ONBOARD_USDC=5

# Sign in with Privy (login tool / aqua0 login): needs SIGNER=circle and CIRCLE_WALLET_SET_ID. The Privy user id becomes
# the Circle wallet refId. Allow http://localhost:8787 on the Privy app client used here. App and client ids are public.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_LOGIN_PORT=8787

# Pegged venue (fixed-price PeggedSwap) used by create_strategy, quote_swap, swap and get_shared_backing.
# Optional on Arc Testnet: empty values fall back to the Arc deployment in deployments/arc-testnet.json.
AQUA_ADAPTER_ADDRESS=
AQUA_SWAPVM_ROUTER_ADDRESS=

# FXSwap venue (oracle-anchored FXSwap, the default opcode when configured). Optional on Arc Testnet: empty
# values fall back to the Arc deployment. The adapter must be the AquaAdapter bound to FXSWAP_ROUTER_ADDRESS.
FXSWAP_ROUTER_ADDRESS=
FXSWAP_AQUA_ADAPTER_ADDRESS=
# Feeds quoting FX units per 1 USD (ManualFxOracle on Arc: only the feed owner can set them).
FX_ORACLE_ARS_USD=
FX_ORACLE_BRL_USD=

# MCP transport configuration.
MCP_TRANSPORT=stdio

# HTTP MCP bind configuration (used when MCP_TRANSPORT=http).
HOST=0.0.0.0
PORT=3000
